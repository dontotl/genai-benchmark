{
  "compartment_id": "ocid1.compartment.oc1..example",
  "benchmark_compartment_id": "ocid1.compartment.oc1..example",
  "bucket_name": "genai-benchmark-results",
  "object_storage_region": "ap-seoul-1",
  "repo_url": "https://github.com/<owner>/genai-benchmark.git",
  "repo_ref": "main",
  "control_profile": "DEFAULT",
  "runner_profile": "DEFAULT",
  "runner_auth_method": "instance_principal",
  "runner_user": "opc",
  "work_dir": "/home/opc/genai-benchmark",
  "shape": "VM.Standard.E4.Flex",
  "shape_config": {
    "ocpus": 1,
    "memoryInGBs": 8
  },
  "network": {
    "mode": "managed_public",
    "name_prefix": "genai-benchmark",
    "vcn_cidr": "10.91.0.0/16",
    "subnet_cidr": "10.91.1.0/24",
    "enable_ssh": false,
    "ssh_source_cidr": "203.0.113.10/32",
    "iam_region": "us-ashburn-1",
    "dns_label": "genaibench",
    "subnet_dns_label": "runner"
  },
  "target_regions": [
    "ap-osaka-1"
  ],
  "benchmark": {
    "repeats": 1,
    "concurrency_levels": "1",
    "prompts": "prompts/sample_prompts.jsonl",
    "report_suffix": "seoul-smoke-r1",
    "extra_args": []
  },
  "runners": [
    {
      "region": "ap-seoul-1",
      "source_label": "ap-seoul-runner",
      "availability_domain": "<availability-domain>",
      "image_id": "ocid1.image.oc1.ap-seoul-1.oracle-linux-8-example",
      "ssh_public_key": "<ssh-rsa-or-ed25519-public-key>"
    }
  ]
}
